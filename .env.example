# Canonical public site (no trailing slash). Used for Open Graph, sitemap, and share links.
NEXT_PUBLIC_SITE_URL=https://lumefuego.com

# Persist waitlist contacts to a Resend audience in production.
# Without these, addresses are stored in data/waitlist.jsonl (gitignored).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Sender for the welcome email. Must be a domain verified in Resend.
# Example: Lume <hola@lumefuego.com>
RESEND_FROM=
