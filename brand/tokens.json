{
  "name": "Lume",
  "version": "0.1.0",
  "note": "Starting CMF. Lock paint chips in sun, grease, and night before production tooling.",
  "color": {
    "primitive": {
      "charcoal": { "hex": "#1C1917", "role": "Ground. Near-black metal, not cool grey." },
      "ink": { "hex": "#2A2420", "role": "Primary text on field." },
      "field": { "hex": "#F4F0EA", "role": "Paper, UI background, packaging interior." },
      "cream": { "hex": "#FAF7F2", "role": "Lifted field. Manuals, site." },
      "ember": { "hex": "#C45C26", "role": "One coal per composition. Never a fill flood." },
      "ember-deep": { "hex": "#9A3F16", "role": "Pressed ember. Wordmark on charcoal optional." },
      "smoke": { "hex": "#8A847C", "role": "Secondary text, captions." },
      "line": { "hex": "#D9D3C9", "role": "Hairlines, rules. Not decoration." },
      "white": { "hex": "#FFFFFF", "role": "Photography mats only." },
      "signal-ok": { "hex": "#3F6B4E", "role": "Filter OK. Never brand decoration." },
      "signal-alert": { "hex": "#A33B2B", "role": "Replace filter / safety. Never brand decoration." }
    },
    "semantic": {
      "bg.ground": "charcoal",
      "bg.field": "field",
      "bg.cream": "cream",
      "text.primary": "ink",
      "text.on-ground": "field",
      "text.secondary": "smoke",
      "text.accent": "ember",
      "border.subtle": "line",
      "action.primary": "ember",
      "feedback.ok": "signal-ok",
      "feedback.alert": "signal-alert"
    }
  },
  "type": {
    "family": {
      "sans": "IBM Plex Sans",
      "fallback": "Inter"
    },
    "wordmark": {
      "family": "IBM Plex Sans",
      "style": "Regular",
      "tracking": 40,
      "note": "Open letterspacing. Never script. Never extra-bold."
    },
    "ramp": {
      "display": { "size": 72, "line": 80, "weight": "Regular" },
      "h1": { "size": 40, "line": 48, "weight": "Medium" },
      "h2": { "size": 24, "line": 32, "weight": "Medium" },
      "body": { "size": 16, "line": 26, "weight": "Regular" },
      "caption": { "size": 12, "line": 18, "weight": "Regular" }
    }
  },
  "space": {
    "unit": 8,
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96]
  },
  "radius": {
    "none": 0,
    "object": 8,
    "pack": 4
  }
}
